{
  "name": "qvac-installed-base-intelligence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.17.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "reset": "node scripts/emergency/reset-workspace.mjs",
    "test": "node --test",
    "e4:verify": "node scripts/e4/verify-artifacts.mjs",
    "e4:probe": "node scripts/e4/probe-qvac.mjs",
    "e4:run": "node scripts/e4/run-feasibility.mjs",
    "e4:topologies": "node scripts/e4/probe-topologies.mjs",
    "e4:interruption": "node scripts/e4/probe-interruption.mjs",
    "e4:offline": "node scripts/e4/probe-offline.mjs",
    "e4:finalize": "node scripts/e4/finalize-results.mjs",
    "e4:v2:fit": "node scripts/e4-v2/probe-model-fit.mjs",
    "probe:compact": "node scripts/emergency/probe-compact-contract.mjs",
    "probe:simple": "node scripts/emergency/probe-simple-json.mjs",
    "smoke:demo": "node scripts/emergency/run-demo-smoke.mjs",
    "smoke:clarification": "node scripts/emergency/run-clarification-smoke.mjs",
    "smoke:correction": "node scripts/emergency/run-correction-smoke.mjs",
    "smoke:confidence": "node scripts/emergency/run-confidence-scoring-smoke.mjs",
    "smoke:opportunities": "node scripts/emergency/run-opportunity-identification-smoke.mjs",
    "smoke:analytics": "node scripts/emergency/run-analytics-deterministic-smoke.mjs",
    "smoke:analytics:real": "node scripts/emergency/run-analytics-real-smoke.mjs",
    "smoke:geography": "node scripts/emergency/run-geographic-map-smoke.mjs",
    "smoke:photo": "node scripts/emergency/run-photo-assisted-capture-smoke.mjs",
    "feasibility:ocr:fixtures": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/feasibility/ocr/generate-synthetic-fixtures.ps1",
    "feasibility:ocr:acquire": "node scripts/feasibility/ocr/acquire-qvac-ocr-models.mjs",
    "feasibility:ocr": "node scripts/feasibility/ocr/run-local-ocr-feasibility.mjs",
    "feasibility:ocr:tesseract:acquire": "node scripts/feasibility/ocr/acquire-tesseract-models.mjs",
    "feasibility:ocr:tesseract": "node scripts/feasibility/ocr/run-tesseract-ocr-feasibility.mjs",
    "feasibility:transcription:fixture": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/feasibility/transcription/generate-spanish-fixture.ps1",
    "feasibility:transcription": "node scripts/feasibility/transcription/run-local-transcription-feasibility.mjs",
    "smoke:freshness": "node scripts/emergency/run-freshness-priority-smoke.mjs",
    "smoke:export-delete": "node scripts/emergency/run-export-delete-smoke.mjs",
    "smoke:performance": "node scripts/emergency/run-performance-benchmark.mjs after"
  },
  "dependencies": {
    "@qvac/sdk": "0.19.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "node": "22.17.0",
    "tesseract.js": "7.0.0"
  }
}
